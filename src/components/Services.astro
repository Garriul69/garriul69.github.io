---
const services = [
  {
    title: 'Replace spreadsheets with a system',
    lead: 'Custom apps and automations connected to the tools you already use.',
    body: 'Web apps, email alerts and integrations with QuickBooks, Microsoft 365 and SharePoint, so work moves without someone copying data by hand.',
    proof: 'At JC Millwork, 303 jobs run in one live system. Estimates go to QuickBooks, and a job updates itself when the client accepts.',
  },
  {
    title: 'Set up and manage your devices',
    lead: 'Every computer enrolled, configured and kept up to date.',
    body: 'Zero-touch setup with Intune and Autopilot, policies that keep company data safe, and patching that runs every day on its own.',
    proof: 'At Harinas Guadalupe, setup went from about 2 days per PC to 3 PCs in an hour, and 110 devices are patched daily.',
  },
  {
    title: 'Close security gaps early',
    lead: 'Protection that finds problems before they cost you.',
    body: 'Next-generation endpoint protection, fixes for known vulnerabilities, and hardening for devices, servers and websites.',
    proof: '105 devices moved to CrowdStrike Falcon, and a remote-code-execution flaw on IP cameras was closed.',
  },
];
---

<section id="services" class="section section--soft" aria-labelledby="services-title">
  <div class="section__inner">
    <header class="section__head">
      <h2 id="services-title" class="section__title">How I can help.</h2>
      <p class="section__lead">
        Three things I do, each with a result behind it.
      </p>
    </header>

    <ul class="svc">
      {services.map((s) => (
        <li class="svc__row">
          <h3 class="svc__title">{s.title}</h3>
          <div class="svc__text">
            <p class="svc__lead">{s.lead}</p>
            <p class="svc__body">{s.body}</p>
          </div>
          <p class="svc__proof">{s.proof}</p>
        </li>
      ))}
    </ul>

    <p class="svc__cta">
      <a href="#contact" class="btn-magnetic btn-primary">Talk about your project</a>
    </p>
  </div>
</section>

<style>
  .svc {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .svc__row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: start;
  }

  .svc__title {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--color-text);
  }
  .svc__lead {
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .svc__body {
    margin-top: 0.5rem;
    max-width: 52ch;
    font-size: 1rem;
    color: var(--color-muted);
  }
  .svc__proof {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text);
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
  }

  .svc__cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (max-width: 900px) {
    .svc__row { grid-template-columns: 1fr; gap: 0.9rem; padding: 1.75rem 0; }
  }
</style>
