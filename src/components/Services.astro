---
const services = [
  {
    title: 'Endpoint management',
    lead: 'Every device enrolled, configured and compliant from day one.',
    body: 'Zero-touch provisioning with Windows Autopilot and Intune, central control through Entra ID, and automated patching.',
    tools: ['Intune', 'Autopilot', 'Entra ID', 'Action1'],
  },
  {
    title: 'Identity & access',
    lead: 'Sign-in you can trust.',
    body: 'Identity hardening and MFA across the organization, so access follows the person and not the machine.',
    tools: ['Entra ID', 'MFA'],
  },
  {
    title: 'Security & compliance',
    lead: 'Next-gen protection instead of legacy antivirus.',
    body: 'EDR migration to CrowdStrike Falcon, data labeling with Microsoft Purview, and hardening of IoT devices, web apps and servers.',
    tools: ['CrowdStrike Falcon', 'Purview', 'Hardening'],
  },
  {
    title: 'Cloud collaboration',
    lead: 'One secure ecosystem for mail and files.',
    body: 'Corporate email consolidated in two phases, from Telmex to Google Workspace and then to Microsoft 365, with OneDrive and SharePoint.',
    tools: ['Microsoft 365', 'Outlook', 'OneDrive', 'SharePoint'],
  },
  {
    title: 'Automation & documentation',
    lead: 'Repeatable by design, and written down.',
    body: 'Deployments, patching and business processes automated, with runbooks and onboarding kept as Markdown in GitHub.',
    tools: ['PowerShell', 'Python', 'n8n', 'GitHub'],
  },
];
---

<section id="services" class="section section--soft" aria-labelledby="services-title">
  <div class="section__inner">
    <header class="section__head">
      <h2 id="services-title" class="section__title">What I take care of.</h2>
      <p class="section__lead">
        Five areas that keep a growing company's technology secure, manageable and documented.
      </p>
    </header>

    <ul class="svc">
      {services.map((s) => (
        <li class="svc__row">
          <h3 class="svc__title">{s.title}</h3>
          <div class="svc__text">
            <p class="svc__lead">{s.lead}</p>
            <p class="svc__body">{s.body}</p>
          </div>
          <ul class="svc__tools" aria-label={`${s.title} tools`}>
            {s.tools.map((t) => <li>{t}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .svc__row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr) minmax(0, 0.8fr);
    gap: 1.5rem 3rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: start;
  }

  .svc__title {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--color-text);
  }
  .svc__lead {
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .svc__body {
    margin-top: 0.5rem;
    max-width: 52ch;
    font-size: 1rem;
    color: var(--color-muted);
  }

  .svc__tools {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: flex-end;
  }
  .svc__tools li {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
  }

  @media (max-width: 900px) {
    .svc__row { grid-template-columns: 1fr; gap: 0.9rem; padding: 1.75rem 0; }
    .svc__tools { justify-content: flex-start; }
  }
</style>
