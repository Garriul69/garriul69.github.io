---
import { site } from '@/lib/site';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`]}>
  <svg class="logo__mark" viewBox="0.8 0.8 29.4 21.4" aria-hidden="true" focusable="false">
    <path
      d="M8 21 H24 A5 5 0 0 0 24 11 H21 V7 A5 5 0 0 0 11 7 V9 H8 A6 6 0 0 0 8 21 Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle class="logo__key" cx="16" cy="13.6" r="1.4" stroke-width="0.8" />
    <path class="logo__key logo__key--stem" d="M16 15 V17.2" fill="none" stroke-width="1.7" stroke-linecap="round" />
  </svg>
  <span class="logo__name">{site.brand}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    --logo-ink: var(--color-text);
    --logo-key: var(--color-accent);
  }
  .logo--dark {
    --logo-ink: #ffffff;
    --logo-key: #7cc4ce;
  }
  .logo__mark {
    height: 1.85rem;
    width: auto;
    color: var(--logo-ink);
    overflow: visible;
  }
  .logo__key {
    fill: var(--logo-key);
    stroke: var(--logo-key);
  }
  .logo__key--stem { fill: none; }
  .logo__name {
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--logo-ink);
  }
</style>
