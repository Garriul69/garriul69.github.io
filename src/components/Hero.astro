---
const stack = [
  { name: 'Microsoft Entra ID',  role: 'Identity & MFA',        state: 'Enforced' },
  { name: 'Microsoft Intune',    role: 'Device management',     state: 'Managed' },
  { name: 'Windows Autopilot',   role: 'Device provisioning',   state: 'Zero-touch' },
  { name: 'CrowdStrike Falcon',  role: 'Endpoint protection',   state: 'Active' },
  { name: 'Microsoft Purview',   role: 'Data classification',   state: 'Labeled' },
];

const toolsStrip = [
  'Microsoft 365', 'Intune', 'Entra ID', 'CrowdStrike', 'Purview', 'PowerShell', 'Python', 'n8n',
];
---

<section id="hero" class="hero">
  <div class="hero__content">
    <h1 class="hero__title" aria-label="Secure, modern IT for growing companies.">
      <span class="hero__line"><span class="hero__word">Secure, modern IT</span></span>
      <span class="hero__line"><span class="hero__word">for growing companies.</span></span>
    </h1>

    <p class="hero__sub" data-hero="fade">
      I'm Andy Gibran López Nambo, a Modern Workplace, Cloud &amp; Security engineer.
      I replace manual setups with managed, protected and automated systems,
      from the endpoint to the cloud.
    </p>

    <div class="hero__ctas" data-hero="fade">
      <a href="#projects" class="btn-magnetic btn-primary">View projects</a>
      <a href="#contact" class="btn-magnetic btn-outline">Contact</a>
    </div>
  </div>

  <!-- Product-style panel: the stack in production + the measured result -->
  <figure class="panel" data-hero="rise">
    <div class="panel__bar">
      <span class="panel__title">Managed environment</span>
      <span class="panel__status"><i aria-hidden="true"></i>Protected</span>
    </div>

    <div class="panel__body">
      <ul class="panel__list">
        {stack.map((row) => (
          <li class="panel__row">
            <div>
              <span class="panel__name">{row.name}</span>
              <span class="panel__role">{row.role}</span>
            </div>
            <span class="panel__state">{row.state}</span>
          </li>
        ))}
      </ul>

      <div class="panel__result">
        <p class="panel__result-title">Time to deploy new PCs</p>

        <div class="bar">
          <div class="bar__label"><span>Before</span><b>~2 days per PC</b></div>
          <div class="bar__track"><span class="bar__fill bar__fill--before"></span></div>
        </div>
        <div class="bar">
          <div class="bar__label"><span>After</span><b>10 PCs in 1 hour</b></div>
          <div class="bar__track"><span class="bar__fill bar__fill--after"></span></div>
        </div>

        <p class="panel__note">Real result from a manufacturing company fleet, 2025.</p>
      </div>
    </div>
  </figure>

  <div class="strip" data-hero="fade">
    <p class="strip__label">Tools I work with every day</p>
    <ul class="strip__list">
      {toolsStrip.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(ellipse 70% 45% at 50% 0%, rgba(11, 95, 107, 0.07), transparent 70%),
      var(--color-bg);
    padding: calc(var(--navbar-h) + clamp(3.5rem, 9vw, 7rem)) 1.5rem clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }

  .hero__content {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .hero__title {
    font-size: clamp(2.75rem, 7.6vw, 5.5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--color-text);
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero__word { display: inline-block; }

  .hero__sub {
    margin: 1.75rem auto 0;
    max-width: 620px;
    font-size: clamp(1.0625rem, 2vw, 1.3125rem);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }

  /* ── Panel ── */
  .panel {
    max-width: 960px;
    margin: clamp(3rem, 7vw, 5rem) auto 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    box-shadow: 0 1px 2px rgba(18, 32, 43, 0.04), 0 30px 60px -30px rgba(18, 32, 43, 0.22);
    overflow: hidden;
  }
  .panel__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.4rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .panel__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .panel__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-success);
  }
  .panel__status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
  }

  .panel__body {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }

  .panel__list { list-style: none; }
  .panel__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }
  .panel__row:last-child { border-bottom: none; }
  .panel__name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }
  .panel__role {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .panel__state {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-success);
    background: rgba(19, 128, 93, 0.09);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .panel__result {
    padding: 1.5rem 1.6rem;
    border-left: 1px solid var(--color-border);
    background: var(--color-surface);
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
  }
  .panel__result-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .bar__label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-bottom: 0.4rem;
  }
  .bar__label b { color: var(--color-text); font-weight: 600; }
  .bar__track {
    height: 10px;
    border-radius: 999px;
    background: #E4E8EC;
    overflow: hidden;
  }
  .bar__fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    transform-origin: left;
  }
  .bar__fill--before { width: 100%; background: #B7C0C9; }
  .bar__fill--after  { width: 6%;   background: var(--color-accent); }
  .panel__note {
    font-size: 0.75rem;
    color: var(--color-soft);
  }

  /* ── Tools strip ── */
  .strip {
    max-width: 960px;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    text-align: center;
  }
  .strip__label {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 1.1rem;
  }
  .strip__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2.25rem;
  }
  .strip__list li {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-soft);
  }

  @media (max-width: 760px) {
    .panel__body { grid-template-columns: 1fr; }
    .panel__result {
      border-left: none;
      border-top: 1px solid var(--color-border);
    }
  }
</style>

<script>
  import gsap from 'gsap';

  function initHero() {
    const hero = document.getElementById('hero');
    if (!hero || hero.dataset.initialized === 'true') return;
    hero.dataset.initialized = 'true';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return; // everything is visible by default

    const words = hero.querySelectorAll('.hero__word');
    const fades = hero.querySelectorAll('[data-hero="fade"]');
    const panel = hero.querySelector('[data-hero="rise"]');
    const afterFill = hero.querySelector('.bar__fill--after');

    gsap.set(words, { yPercent: 110 });
    gsap.set(fades, { opacity: 0, y: 10 });
    gsap.set(panel, { opacity: 0, y: 40 });
    gsap.set(afterFill, { scaleX: 0 });

    // One orchestrated entrance: headline → copy → panel → the result bar fills.
    gsap.timeline({ defaults: { ease: 'power3.out' } })
      .to(words, { yPercent: 0, duration: 0.9, stagger: 0.12 }, 0.1)
      .to(fades, { opacity: 1, y: 0, duration: 0.7, stagger: 0.1 }, 0.55)
      .to(panel, { opacity: 1, y: 0, duration: 0.9 }, 0.8)
      .to(afterFill, { scaleX: 1, duration: 0.8, ease: 'power2.out' }, 1.5);
  }

  const boot = () => requestAnimationFrame(() => requestAnimationFrame(initHero));

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
</script>
