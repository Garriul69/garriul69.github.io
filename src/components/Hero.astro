---
import { site } from '@/lib/site';

// Proof first: three results the visitor can check against the case studies below.
const proof = [
  { value: '303',    label: 'jobs managed in one live system',          client: 'JC Millwork · Phoenix, AZ' },
  { value: '110',    label: 'devices patched every day, automatically', client: 'Harinas Guadalupe' },
  { value: '3 PCs',  label: 'ready per hour, down from about 2 days each', client: 'Harinas Guadalupe' },
];

// Logos live in src/assets/logos/<key>.svg.
const logoFiles = import.meta.glob('/src/assets/logos/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const logoSvg = (key?: string) => (key ? logoFiles[`/src/assets/logos/${key}.svg`] ?? '' : '');

// `color`: multi-color source icon, flattened to grey. `scale`: optical size correction.
const toolGroups = [
  { label: 'Microsoft 365', items: [
    { name: 'Microsoft 365', logo: 'microsoft-365', color: true },
    { name: 'SharePoint', logo: 'sharepoint' },
    { name: 'OneDrive', logo: 'onedrive' },
    { name: 'Outlook', logo: 'outlook' },
  ] },
  { label: 'Identity and security', items: [
    { name: 'Entra ID', logo: 'entra-id', scale: 0.95 },
    { name: 'Intune', logo: 'intune', color: true },
    { name: 'Purview', logo: 'purview', color: true },
    { name: 'CrowdStrike Falcon', logo: 'crowdstrike-falcon', scale: 1.1 },
    { name: 'Action1', logo: 'action1', wordmark: true },
  ] },
  { label: 'Automation', items: [
    { name: 'Power Automate', logo: 'power-automate', scale: 0.95 },
    { name: 'Power Apps', logo: 'power-apps' },
    { name: 'n8n', logo: 'n8n', scale: 1.1 },
    { name: 'Make', logo: 'make' },
    { name: 'PowerShell', logo: 'powershell' },
    { name: 'Python', logo: 'python' },
  ] },
  { label: 'Cloud and business apps', items: [
    { name: 'Google Workspace', logo: 'google' },
    { name: 'Cloudflare', logo: 'cloudflare' },
    { name: 'Vercel', logo: 'vercel', scale: 0.85 },
    { name: 'QuickBooks', logo: 'quickbooks', scale: 0.95 },
  ] },
];
---

<section id="hero" class="hero">
  <div class="hero__content">
    <h1 class="hero__title" aria-label="I replace manual work with systems that run themselves.">
      <span class="hero__line"><span class="hero__word">I replace manual work</span></span>
      <span class="hero__line"><span class="hero__word">with systems that run themselves.</span></span>
    </h1>

    <p class="hero__sub" data-hero="fade">
      I'm Andy Gibran López Nambo, an IT engineer. I moved a millwork company in
      Arizona from a spreadsheet to a live job system, and cut device setup from
      two days per PC to three PCs an hour.
    </p>

    <div class="hero__ctas" data-hero="fade">
      <a href="#projects" class="btn-magnetic btn-primary">See the results</a>
      <a href="#contact" class="btn-magnetic btn-outline">Work with me</a>
    </div>

    <p class="hero__cv" data-hero="fade">
      Download my CV:
      <a href={site.cv.en} download lang="en" hreflang="en">English</a>
      <span aria-hidden="true">·</span>
      <a href={site.cv.es} download lang="es" hreflang="es">Español</a>
      <span class="hero__cv-note">PDF</span>
    </p>
  </div>

  <ul class="proof" data-hero="rise" aria-label="Results">
    {proof.map((p) => (
      <li class="proof__item">
        <span class="proof__value">{p.value}</span>
        <span class="proof__label">{p.label}</span>
        <span class="proof__client">{p.client}</span>
      </li>
    ))}
  </ul>

  <div class="strip" data-hero="fade">
    <p class="strip__title">Technologies I work with</p>
    <div class="strip__groups">
      {toolGroups.map((g) => (
        <div class="strip__group">
          <p class="strip__label">{g.label}</p>
          <ul class="strip__list">
            {g.items.map((t) => (
              <li>
                {t.wordmark ? (
                  <span class="strip__wordmark" role="img" aria-label={t.name} set:html={logoSvg(t.logo)} />
                ) : (
                  <>
                    <span class:list={['strip__icon', { 'strip__icon--color': t.color }]} aria-hidden="true" style={`--icon-scale:${t.scale ?? 1}`} set:html={logoSvg(t.logo)} />
                    {t.name}
                  </>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(ellipse 70% 45% at 50% 0%, rgba(11, 95, 107, 0.07), transparent 70%),
      var(--color-bg);
    padding: calc(var(--navbar-h) + clamp(3.5rem, 9vw, 7rem)) 1.5rem clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }

  .hero__content {
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
  }

  .hero__title {
    font-size: clamp(2.3rem, 5.6vw, 4rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--color-text);
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero__word {
    display: inline-block;
    text-wrap: balance;
  }

  .hero__sub {
    margin: 1.75rem auto 0;
    max-width: 640px;
    font-size: clamp(1.0625rem, 2vw, 1.3125rem);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }

  .hero__cv {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .hero__cv a {
    color: var(--color-accent);
    font-weight: 500;
    text-underline-offset: 3px;
  }
  .hero__cv a:hover { text-decoration: underline; }
  .hero__cv span[aria-hidden] { margin: 0 0.35rem; color: var(--color-soft); }
  .hero__cv-note { margin-left: 0.4rem; font-size: 0.75rem; color: var(--color-soft); }

  /* ── Proof: three results, divided by hairlines instead of cards ── */
  .proof {
    list-style: none;
    max-width: var(--container);
    margin: clamp(3rem, 7vw, 5rem) auto 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .proof__item {
    display: flex;
    flex-direction: column;
    padding: 2rem 2rem 2rem 0;
  }
  .proof__item + .proof__item {
    padding-left: 2rem;
    border-left: 1px solid var(--color-border);
  }
  .proof__value {
    font-size: clamp(2.75rem, 5.5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-accent);
  }
  .proof__label {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
    max-width: 22ch;
  }
  .proof__client {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* ── Technologies, grouped ── */
  .strip {
    max-width: var(--container);
    margin: clamp(3rem, 7vw, 5rem) auto 0;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-border);
  }
  .strip__title {
    text-align: center;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-muted);
    margin-bottom: 1.75rem;
  }
  .strip__groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.75rem 2rem;
    text-align: left;
  }
  .strip__label {
    font-size: 0.8125rem;
    color: var(--color-soft);
    margin-bottom: 0.6rem;
  }
  .strip__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .strip__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-text);
  }
  .strip__icon {
    flex: none;
    width: 1.875rem;
    height: 1.875rem;
    color: var(--color-soft);
  }
  /* Wordmark-only logos (no symbol): the logo takes the place of the name */
  .strip__wordmark {
    display: block;
    height: 1.2rem;
    color: var(--color-muted);
  }
  .strip__wordmark :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
  .strip__wordmark :global(path) {
    fill: currentColor;
  }
  .strip__icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
    transform: scale(var(--icon-scale, 1));
  }
  /* Multi-color source icons: flatten to the same grey as the single-color ones */
  .strip__icon--color :global(svg) {
    filter: grayscale(1);
    opacity: 0.6;
  }

  @media (max-width: 760px) {
    .strip__groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof { grid-template-columns: 1fr; }
    .proof__item,
    .proof__item + .proof__item {
      padding: 1.5rem 0;
      border-left: none;
    }
    .proof__item + .proof__item { border-top: 1px solid var(--color-border); }
    .proof__label { max-width: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  function initHero() {
    const hero = document.getElementById('hero');
    if (!hero || hero.dataset.initialized === 'true') return;
    hero.dataset.initialized = 'true';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return; // everything is visible by default

    const words = hero.querySelectorAll('.hero__word');
    const fades = hero.querySelectorAll('[data-hero="fade"]');
    const proof = hero.querySelector('[data-hero="rise"]');

    gsap.set(words, { yPercent: 110 });
    gsap.set(fades, { opacity: 0, y: 10 });
    gsap.set(proof, { opacity: 0, y: 30 });

    // One orchestrated entrance: headline → copy → results.
    gsap.timeline({ defaults: { ease: 'power3.out' } })
      .to(words, { yPercent: 0, duration: 0.9, stagger: 0.12 }, 0.1)
      .to(fades, { opacity: 1, y: 0, duration: 0.7, stagger: 0.1 }, 0.55)
      .to(proof, { opacity: 1, y: 0, duration: 0.9 }, 0.8);
  }

  const boot = () => requestAnimationFrame(() => requestAnimationFrame(initHero));

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
</script>
