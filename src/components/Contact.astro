---
import { site } from '@/lib/site';
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__inner">
    <h2 id="contact-title" class="contact__title">
      Let's secure and modernize your IT.
    </h2>
    <p class="contact__lead">
      Tell me about your environment and I'll reply with where I'd start.
      Available for remote engagements with U.S. teams.
    </p>

    <div class="contact__actions">
      {site.email && (
        <a href={`mailto:${site.email}`} class="contact__btn contact__btn--primary">Email me</a>
      )}
      {site.linkedin && (
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="contact__btn contact__btn--ghost">LinkedIn</a>
      )}
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="contact__btn contact__btn--ghost">GitHub</a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-ink);
    color: var(--color-ink-text);
    padding: clamp(5rem, 11vw, 9rem) 1.5rem;
    text-align: center;
  }
  .contact__inner {
    max-width: 780px;
    margin: 0 auto;
  }
  .contact__title {
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #fff;
  }
  .contact__lead {
    margin: 1.4rem auto 0;
    max-width: 540px;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }
  .contact__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    border-radius: 980px;
    padding: 0.9rem 1.7rem;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .contact__btn--primary {
    background: #fff;
    color: var(--color-ink);
  }
  .contact__btn--primary:hover { background: #DDE6EB; }
  .contact__btn--ghost {
    color: var(--color-ink-text);
    border: 1px solid #3A4E5C;
  }
  .contact__btn--ghost:hover { border-color: #fff; color: #fff; }
  .contact :focus-visible { outline-color: #fff; }
</style>
