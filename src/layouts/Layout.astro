---
import Navbar from '@/components/Navbar.astro';
import Logo from '@/components/Logo.astro';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import { site } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Andy Gibran López Nambo — Modern Workplace, Cloud & Security Engineer',
  description = 'I find weaknesses in infrastructure and modernize how teams work — from the endpoint to the cloud. Microsoft Intune, Autopilot, Entra ID, CrowdStrike, PowerShell.',
  ogImage = '/og.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://gibranlopez.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Andy Gibran López Nambo" />

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:type"        content="website" />

    <!-- Twitter -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <div class="footer__row">
          <Logo variant="dark" />
          <span class="footer__copy">
            © 2026 {site.name}. All rights reserved.
          </span>
          <div class="footer__links">
            <a href="/privacy" class="footer__link">Privacy</a>
            <a href="/vault" class="footer__link">Vault</a>
            {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="footer__link">LinkedIn</a>}
            {site.github && <a href={site.github} target="_blank" rel="noopener noreferrer" class="footer__link">GitHub</a>}
          </div>
        </div>
        <p class="footer__legal">
          Product names, logos and brands shown on this site belong to their respective owners.
          They appear only to identify technologies I work with and do not imply affiliation,
          sponsorship or endorsement. Some icons come from
          <a href="https://github.com/homarr-labs/dashboard-icons" target="_blank" rel="noopener noreferrer">Dashboard Icons</a>
          (<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>)
          and <a href="https://simpleicons.org" target="_blank" rel="noopener noreferrer">Simple Icons</a> (CC0).
        </p>
      </div>
    </footer>
  </body>
</html>

<!-- Lenis smooth scroll init -->
<script>
  import Lenis from 'lenis';

  try {
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    (window as any).__lenis = lenis;
  } catch {
    /* scroll nativo si Lenis no carga */
  }
</script>

<style>
  .footer {
    background: var(--color-ink);
    border-top: 1px solid var(--color-ink-line);
    padding: 1.75rem 1.5rem;
  }
  .footer__inner {
    max-width: var(--container);
    margin: 0 auto;
  }
  .footer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer__legal {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ink-line);
    max-width: 78ch;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .footer__legal a {
    color: var(--color-ink-text);
    text-underline-offset: 3px;
  }
  .footer__copy {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    margin-right: auto;
    margin-left: 1rem;
  }
  .footer__links {
    display: flex;
    gap: 1.5rem;
  }
  .footer__link {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer__link:hover { color: #fff; }
</style>
